import java.util.*;

public class BasicToJavaInterpreter {
    private final Map<String, Integer> variables = new HashMap<>(); // Store variables

    public void eval(String code) {
        String[] lines = code.split("\n"); // Split the BASIC program by lines
        Map<Integer, String> program = new TreeMap<>(); // Store code by line number

        // Parse lines with line numbers
        for (String line : lines) {
            line = line.trim();
            if (line.isEmpty()) continue;

            int spaceIndex = line.indexOf(' ');
            int lineNumber = Integer.parseInt(line.substring(0, spaceIndex)); // Extract line number
            String command = line.substring(spaceIndex + 1).trim(); // Extract command
            program.put(lineNumber, command);
        }

        // Execute lines in ascending order
        for (String command : program.values()) {
            executeCommand(command);
        }
    }

    private void executeCommand(String command) {
        if (command.startsWith("LET")) {
            handleAssignment(command);
        } else if (command.startsWith("PRINT")) {
            handlePrint(command);
        } else {
            System.out.println("Unknown command: " + command);
        }
    }

    private void handleAssignment(String command) {
        // Example- LET X = 10 + 5
        String[] parts = command.split("=");
        String varName = parts[0].replace("LET", "").trim(); // Extract variable name
        String expression = parts[1].trim(); // Extract the expression
        int value = evaluateExpression(expression); // Evaluate the expression
        variables.put(varName, value); // Store in the variables map
    }

    private void handlePrint(String command) {
        // Example- PRINT X
        String varName = command.replace("PRINT", "").trim(); // Extract variable name
        if (variables.containsKey(varName)) {
            System.out.println(variables.get(varName)); // Print the variable's value
        } else {
            System.out.println("Error: Variable " + varName + " not defined");
        }
    }

    private int evaluateExpression(String expression) {
        // Split the expression into terms and operators
        String[] tokens = expression.split(" ");
        Stack<Integer> values = new Stack<>();
        Stack<String> operators = new Stack<>();

        for (String token : tokens) {
            token = token.trim();
            if (token.matches("\\d+")) { // If the token is a number
                values.push(Integer.parseInt(token));
            } else if (token.matches("[+\\-*/]")) { // If the token is an operator
                operators.push(token);
            } else if (variables.containsKey(token)) { // If the token is a variable
                values.push(variables.get(token));
            }
        }


        while (!operators.isEmpty()) {
            int b = values.pop();
            int a = values.pop();
            String operator = operators.pop();

            switch (operator) {
                case "+" -> values.push(a + b);
                case "-" -> values.push(a - b);
                case "*" -> values.push(a * b);
                case "/" -> values.push(a / b);
            }
        }

        return values.pop(); // final result
    }

    public static void main(String[] args) {
        BasicToJavaInterpreter interpreter = new BasicToJavaInterpreter();

        // Example
        String program = """
            10 LET X = 10 - 6
            20 LET Y = X * 2
            30 LET Z = Y + 5
            40 PRINT X
            50 PRINT Y
            60 PRINT Z
        """;

        interpreter.eval(program);
    }
}
